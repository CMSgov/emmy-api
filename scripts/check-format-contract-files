#!/usr/bin/env bash
# Checks formatting for hand-authored YAML and JSON contract files with Prettier.
# Exits non-zero if any file differs from the repo's formatting rules.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$repo_root"
pnpm exec prettier --check "api-spec/**/*.yaml" "schema/**/*.json" "swagger-ui/**/*.yaml"
