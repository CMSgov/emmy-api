#!/usr/bin/env bash
# Lints hand-authored YAML files under api-spec/ and swagger-ui/.
# Exits non-zero if yamllint reports style or syntax issues.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
yamllint_config="$repo_root/.yamllint.yaml"

if [[ ! -f "$yamllint_config" ]]; then
  echo "error: yamllint config not found at $yamllint_config" >&2
  exit 1
fi

cd "$repo_root"

if ! python3 -c 'import yamllint' >/dev/null 2>&1; then
  python3 -m pip install --user --disable-pip-version-check yamllint
fi

python3 -m yamllint -c .yamllint.yaml api-spec swagger-ui
