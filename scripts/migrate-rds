#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./emmy-common.sh
source "$script_dir/emmy-common.sh"

emmy_require_cmd aws
emmy_require_cmd jq

if [[ $# -lt 1 ]]; then
  echo "usage: $0 ENV [COMMAND]" >&2
  echo "example: $0 dev up" >&2
  exit 1
fi

env_name="$1"
command="${2:-up}"
emmy_validate_env "$env_name"

cluster_name="$(emmy_cluster_name "$env_name")"
# We assume there is a specific migration task definition or we override the api one
# For Emmy, we'll try to use the api task definition but override the command
task_family="$(emmy_task_family "$env_name")"

echo "Running migration '$command' in environment '$env_name'..."

# Fetch the latest task definition to get network configuration if needed,
# but usually, we just need the family to run-task.
# We'll need subnets and security groups for awsvpc mode.

# Get the service to find its network configuration
service_info=$(aws ecs describe-services --cluster "$cluster_name" --services "$(emmy_service_name "$env_name")" --output json)
subnets=$(echo "$service_info" | jq -r '.services[0].networkConfiguration.awsvpcConfiguration.subnets | join(",")')
security_groups=$(echo "$service_info" | jq -r '.services[0].networkConfiguration.awsvpcConfiguration.securityGroups | join(",")')

if [[ -z "$subnets" || "$subnets" == "null" ]]; then
  echo "error: could not determine subnets for environment $env_name" >&2
  exit 1
fi

echo "Launching one-off migration task..."
task_arn=$(aws ecs run-task \
  --cluster "$cluster_name" \
  --task-definition "$task_family" \
  --launch-type FARGATE \
  --network-configuration "awsvpcConfiguration={subnets=[$subnets],securityGroups=[$security_groups],assignPublicIp=DISABLED}" \
  --overrides "{
    \"containerOverrides\": [
      {
        \"name\": \"emmy-api\",
        \"command\": [\"./migrate\", \"-path\", \"./migrations\", \"$command\"]
      }
    ]
  }" \
  --query 'tasks[0].taskArn' \
  --output text)

if [[ "$task_arn" == "None" || -z "$task_arn" ]]; then
  echo "error: failed to start migration task" >&2
  exit 1
fi

echo "Task started: $task_arn"
echo "Waiting for task to complete..."

aws ecs wait tasks-stopped --cluster "$cluster_name" --tasks "$task_arn"

# Check exit code
exit_code=$(aws ecs describe-tasks --cluster "$cluster_name" --tasks "$task_arn" \
  --query 'tasks[0].containers[0].exitCode' --output text)

if [[ "$exit_code" == "0" ]]; then
  echo "Migration completed successfully."
else
  echo "error: migration task failed with exit code $exit_code" >&2
  # Try to show logs?
  exit 1
fi
