#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./emmy-common.sh
source "$script_dir/emmy-common.sh"

emmy_require_cmd docker
emmy_require_cmd git

# Override repo for the lambda image
readonly EMMY_REPORTING_IMAGE_REPO="${EMMY_REPORTING_IMAGE_REPO:-artifactory.cloud.cms.gov/emmy-docker/emmy-verification-processor}"

context_path="${1:-$(emmy_repo_root)}"
image_tag="$(emmy_image_tag)"
image_uri="$EMMY_REPORTING_IMAGE_REPO:$image_tag"
platform="${PLATFORM:-linux/amd64}"

echo "Building $image_uri for $platform from $context_path using Dockerfile.reporting-lambda"
docker buildx build -t "$image_uri" --platform "$platform" --load -f "$context_path/Dockerfile.reporting-lambda" "$context_path"
