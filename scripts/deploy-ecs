#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./emmy-common.sh
source "$script_dir/emmy-common.sh"

emmy_require_cmd aws
emmy_require_cmd git
emmy_require_cmd jq

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: $0 ENV [IMAGE_TAG]" >&2
  exit 1
fi

env_name="$1"
emmy_validate_env "$env_name"

if [[ $# -eq 2 ]]; then
  export IMAGE_TAG="$2"
fi

image_tag="$(emmy_image_tag)"
image_uri="$(emmy_image_uri "$image_tag")"
cluster_name="$(emmy_cluster_name "$env_name")"
service_name="$(emmy_service_name "$env_name")"
task_family="$(emmy_task_family "$env_name")"

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

task_definition_json="$tmp_dir/task-definition.json"
register_payload_json="$tmp_dir/register-payload.json"

echo "Fetching task definition $task_family"
aws ecs describe-task-definition \
  --task-definition "$task_family" \
  --output json > "$task_definition_json"

container_name="${CONTAINER_NAME:-}"
if [[ -z "$container_name" ]]; then
  matching_container_count="$(
    jq --arg task_family "$task_family" '[.taskDefinition.containerDefinitions[] | select(.name == $task_family)] | length' "$task_definition_json"
  )"
  container_count="$(
    jq '[.taskDefinition.containerDefinitions[]] | length' "$task_definition_json"
  )"

  if [[ "$matching_container_count" == "1" ]]; then
    container_name="$task_family"
  elif [[ "$container_count" == "1" ]]; then
    container_name="$(
      jq -r '.taskDefinition.containerDefinitions[0].name' "$task_definition_json"
    )"
  else
    echo "error: task definition has multiple containers; set CONTAINER_NAME to choose which image to update" >&2
    exit 1
  fi
fi

selected_container_count="$(
  jq --arg container_name "$container_name" '[.taskDefinition.containerDefinitions[] | select(.name == $container_name)] | length' "$task_definition_json"
)"

if [[ "$selected_container_count" != "1" ]]; then
  echo "error: container '$container_name' was not found in task definition $task_family" >&2
  exit 1
fi

echo "Registering a new task definition revision for $task_family with image $image_uri"
jq \
  --arg container_name "$container_name" \
  --arg image_uri "$image_uri" \
  '
  .taskDefinition
  | {
      family,
      taskRoleArn,
      executionRoleArn,
      networkMode,
      containerDefinitions,
      volumes,
      placementConstraints,
      requiresCompatibilities,
      cpu,
      memory,
      tags,
      pidMode,
      ipcMode,
      proxyConfiguration,
      inferenceAccelerators,
      ephemeralStorage,
      runtimePlatform
    }
  | .containerDefinitions |= map(
      if .name == $container_name then
        .image = $image_uri
      else
        .
      end
    )
  | walk(if type == "object" then with_entries(select(.value != null)) else . end)
  ' "$task_definition_json" > "$register_payload_json"

new_task_definition_arn="$(
  aws ecs register-task-definition \
    --cli-input-json "file://$register_payload_json" \
    --query 'taskDefinition.taskDefinitionArn' \
    --output text
)"

echo "Updating service $service_name in cluster $cluster_name"
aws ecs update-service \
  --cluster "$cluster_name" \
  --service "$service_name" \
  --task-definition "$new_task_definition_arn" \
  --output json >/dev/null

echo "Waiting for service $service_name to become stable"
aws ecs wait services-stable \
  --cluster "$cluster_name" \
  --services "$service_name"

echo "Deployment complete: $service_name is running task definition $new_task_definition_arn"
