                }
              }
            ]
          },
          "dataSource": "National Student Clearinghouse"
        }
      },
      "GetVeteranDisabilityStatusRequestExample": {
        "value": {
          "firstName": "Lynette",
          "middleName": "Marie",
          "lastName": "Oyola",
          "dateOfBirth": "1988-10-24",
          "address": {
            "street1": "17020 Tortoise St",
            "city": "Round Rock",
            "state": "TX",
            "postalCode": "78664",
            "country": "USA"
          }
        }
      },
      "VeteranDisabilityStatusResponseExample": {
        "value": {
          "combinedDisabilityRating": 70,
          "rawData": {
            "data": {
              "attributes": {
                "combined_disability_rating": 70
              }
            }
          },
          "dataSource": "Veteran's Affairs"
        }
      }
    }
  }
}