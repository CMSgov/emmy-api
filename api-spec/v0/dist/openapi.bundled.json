{
  "openapi": "3.1.0",
  "info": {
    "title": "Verification Service API",
    "version": "0.1.0",
    "contact": {
      "name": "Eligibility Made Easy (Emmy)",
      "url": "https://www.cms.gov/medicaid-chip/community-engagement-support/eligibility-made-easy"
    },
    "summary": "Alpha API contract for Emmy verification workflows supporting community engagement reporting.\n",
    "description": "Public alpha API contract for the Eligibility Made Easy (Emmy) verification service. Emmy is a CMS-developed suite of open-source tools that supports community engagement reporting through data sharing and verification across multiple data sources. This API allows state-managed applications to submit standardized identity payloads and request verification results such as education enrollment and VA disability rating data. Client applications must authenticate with an OAuth 2.0 bearer token obtained through the client credentials flow. This API is not stable and should be treated as highly volatile for the next several months. Breaking changes are likely as the alpha release evolves.\n"
  },
  "servers": [
    {
      "url": "https://api.dev.emmy.cms.gov",
      "description": "Emmy development environment"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local development"
    }
  ],
  "security": [
    {
      "OAuth2ClientCredentials": []
    }
  ],
  "tags": [
    {
      "name": "Education Verification",
      "description": "Operations for retrieving education enrollment data used in community engagement reporting\n"
    },
    {
      "name": "Veteran Verification",
      "description": "Operations for retrieving VA disability rating data used in community engagement reporting\n"
    }
  ],
  "paths": {
    "/api/v0/education-enrollments": {
      "post": {
        "tags": [
          "Education Verification"
        ],
        "summary": "Get education enrollment status",
        "description": "Returns the subject's current education enrollment status for the person identified in the supplied identity object. The caller must also present a bearer token proving the client application is authorized to use this API.\n",
        "operationId": "getEducationEnrollmentStatus",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/identity.schema"
              },
              "examples": {
                "standard": {
                  "$ref": "#/components/examples/GetEducationEnrollmentRequestExample"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Education enrollment status retrieved successfully.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/X-Request-ID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EducationEnrollmentResponse"
                },
                "examples": {
                  "enrolled": {
                    "$ref": "#/components/examples/EducationEnrollmentResponseExample"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/veteran-disability-ratings": {
      "post": {
        "tags": [
          "Veteran Verification"
        ],
        "summary": "Get veteran disability status",
        "description": "Returns the subject's veteran combined disability rating for the person identified in the supplied identity object. The caller must also present a bearer token proving the client application is authorized to use this API.\n",
        "operationId": "getVeteranDisabilityStatus",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/identity.schema"
              },
              "examples": {
                "standard": {
                  "$ref": "#/components/examples/GetVeteranDisabilityStatusRequestExample"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Veteran disability status retrieved successfully.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/X-Request-ID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VeteranDisabilityStatusResponse"
                },
                "examples": {
                  "rated": {
                    "$ref": "#/components/examples/VeteranDisabilityStatusResponseExample"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2ClientCredentials": {
        "type": "oauth2",
        "description": "OAuth 2.0 bearer token proving the client application is authorized to access the Verification Service API. Only the client credentials grant is supported.\n",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.dev.emmy.cms.gov/oauth2/token",
            "scopes": {}
          }
        }
      }
    },
    "headers": {
      "X-Request-ID": {
        "description": "Unique identifier for the request, used for tracing and debugging. This ID is generated by the server and returned in the response.\n",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "GetEducationEnrollmentRequest": {
        "$ref": "#/components/schemas/identity.schema"
      },
      "EducationEnrollmentResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enrollmentStatus",
          "rawData",
          "dataSource"
        ],
        "properties": {
          "enrollmentStatus": {
            "$ref": "#/components/schemas/school_enrollment_status.schema",
            "description": "Current enrollment status for the identified person."
          },
          "rawData": {
            "type": "object",
            "description": "Raw response data from the National Student Clearinghouse."
          },
          "dataSource": {
            "type": "string",
            "description": "The source of the enrollment data.",
            "example": "National Student Clearinghouse"
          }
        }
      },
      "GetVeteranDisabilityStatusRequest": {
        "$ref": "#/components/schemas/identity.schema"
      },
      "VeteranDisabilityStatusResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "combinedDisabilityRating",
          "rawData",
          "dataSource"
        ],
        "properties": {
          "combinedDisabilityRating": {
            "$ref": "#/components/schemas/combined_disability_rating.schema",
            "description": "VA combined disability rating for the identified person."
          },
          "rawData": {
            "type": "object",
            "description": "Raw response data from Veteran's Affairs."
          },
          "dataSource": {
            "type": "string",
            "description": "The source of the disability rating data.",
            "example": "Veteran's Affairs"
          }
        }
      },
      "date.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Date",
        "description": "Calendar date expressed as an ISO 8601 full-date string in YYYY-MM-DD format.",
        "type": "string",
        "format": "date",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "examples": [
          "2026-03-27"
        ]
      },
      "ssn.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "SSN",
        "description": "Social Security number represented either as a full formatted value (XXX-XX-XXXX) or as the last four digits (XXXX).",
        "type": "string",
        "pattern": "^(?:[0-9]{3}-[0-9]{2}-[0-9]{4}|[0-9]{4})$",
        "examples": [
          "123-45-6789",
          "6789"
        ]
      },
      "address.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Address",
        "description": "Postal address used when a lookup requires demographic matching instead of SSN matching.",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "street1": {
            "type": "string",
            "description": "Primary street address line.",
            "examples": [
              "17020 Tortoise St"
            ]
          },
          "street2": {
            "type": "string",
            "description": "Secondary street address line when available.",
            "examples": [
              "Apt 4B"
            ]
          },
          "street3": {
            "type": "string",
            "description": "Additional street address line when available.",
            "examples": [
              "Building C"
            ]
          },
          "city": {
            "type": "string",
            "description": "City or locality.",
            "examples": [
              "Round Rock"
            ]
          },
          "state": {
            "type": "string",
            "description": "State, province, or region code.",
            "examples": [
              "TX"
            ]
          },
          "postalCode": {
            "type": "string",
            "description": "Postal or ZIP code.",
            "examples": [
              "78664"
            ]
          },
          "country": {
            "type": "string",
            "description": "Country name or code.",
            "examples": [
              "USA"
            ]
          }
        }
      },
      "identity.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Identity",
        "description": "Basic identifying information for a person.",
        "type": "object",
        "additionalProperties": true,
        "required": [
          "firstName",
          "lastName",
          "dateOfBirth"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "description": "Person's legal first name.",
            "examples": [
              "Lynette"
            ]
          },
          "middleName": {
            "type": "string",
            "description": "Person's legal middle name when available.",
            "examples": [
              "Marie"
            ]
          },
          "lastName": {
            "type": "string",
            "description": "Person's legal last name.",
            "examples": [
              "Oyola"
            ]
          },
          "dateOfBirth": {
            "$ref": "#/components/schemas/date.schema",
            "description": "Person's date of birth."
          },
          "ssn": {
            "$ref": "#/components/schemas/ssn.schema",
            "description": "Social Security number when available."
          },
          "address": {
            "$ref": "#/components/schemas/address.schema",
            "description": "Postal address when a lookup requires demographic matching instead of SSN matching."
          }
        }
      },
      "school_enrollment_status.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "SchoolEnrollmentStatus",
        "description": "Enrollment intensity status for a student's school attendance.",
        "type": "string",
        "enum": [
          "FULL_TIME",
          "PART_TIME",
          "LESS_THAN_PART_TIME",
          "ENROLLED"
        ],
        "examples": [
          "FULL_TIME",
          "ENROLLED"
        ]
      },
      "combined_disability_rating.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "CombinedDisabilityRating",
        "description": "VA combined disability rating percentage used to quantify the overall severity of a veteran's service-connected disabilities.",
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "examples": [
          70
        ]
      }
    },
    "examples": {
      "GetEducationEnrollmentRequestExample": {
        "value": {
          "firstName": "Lynette",
          "middleName": "Marie",
          "lastName": "Oyola",
          "dateOfBirth": "1988-10-24",
          "ssn": "123-45-6789"
        }
      },
      "EducationEnrollmentResponseExample": {
        "value": {
          "enrollmentStatus": "ENROLLED",
          "rawData": {
            "clientData": {
              "zaccountID": "",
              "caseReferenceId": "",
              "contactEmail": "",
              "organizationName": ""
            },
            "identityDetails": null,
            "status": {
              "code": "0",
              "message": "Successful",
              "severity": "Info"
            },
            "studentInfoProvided": {
              "dateOfBirth": "1988-10-24",
              "firstName": "Lynette",
              "lastName": "Oyola",
              "middleName": ""
            },
            "transactionDetails": {
              "notifiedDate": "2026-04-06 15:04:06.122",
              "nscHit": "Y",
              "orderId": "115201183",
              "requestedBy": "CMS Contact",
              "requestedDate": "2026-04-06 15:04:06.122",
              "salesTax": "0.00",
              "transactionFee": "0.00",
              "transactionId": "828881291",
              "transactionStatus": "CNF",
              "transactionTotal": "0.00",
              "appliedLikeSchoolMatching": "",
              "studentComments": ""
            },
            "enrollmentDetails": [
              {
                "officialSchoolName": "Trident University International",
                "enrollmentSinceDate": "",
                "currentEnrollmentStatus": "CC",
                "enrollmentData": [
                  {
                    "enrollmentStatus": "Y",
                    "termBeginDate": "2024-05-31",
                    "termEndDate": "2024-11-19",
                    "schoolCertifiedOnDate": "2024-07-16",
                    "anticipatedGraduationDate": "2025-12-30",
                    "studentClassCredential": ""
                  }
                ],
                "studentAddress": {
                  "address1": "2489 O Conner Street",
                  "address2": "",
                  "city": "Pascagoula",
                  "state": "MS",
                  "zipCode": "39567",
                  "province": "",
